            <children>
                <VBox fx:id="cardLucroMonetario" blendMode="SRC_ATOP" maxHeight="-Infinity" maxWidth="-Infinity" spacing="5.0" StackPane.alignment="CENTER">
                    <Label fx:id="iconeLucroMonetario">
                        <graphic>
                            <ImageView fitHeight="50.0" fitWidth="50.0">
                                <Image url="@../../icons/home/lucro_monetario.png" />
                                <viewport><Rectangle2D /></viewport>
                            </ImageView>
                        </graphic>
                    </Label>
                    <Label text="Lucro Monetário">
                        <font><Font name="Tahoma Bold" size="14.0" /></font>
                    </Label>
                    <Label fx:id="lblValorLucroMonetario" text="valor">
                        <font><Font name="Trebuchet MS Bold" size="16.0" /></font>
                    </Label>
                    <cursor><Cursor fx:constant="DEFAULT" /></cursor>
                    <effect><Blend /></effect>
                </VBox>
            </children>
         <effect>
            <ColorAdjust />
         </effect>
        </StackPane>

        <StackPane prefHeight="140.0" prefWidth="140.0" style="-fx-background-color: #ffffff; -fx-background-radius: 15; -fx-border-color: #cccccc; -fx-border-width: 1; -fx-border-radius: 15;">
            <children>
                <VBox fx:id="cardLucroPercentual" blendMode="SRC_ATOP" maxHeight="-Infinity" maxWidth="-Infinity" spacing="5.0" StackPane.alignment="CENTER">
                    <Label fx:id="iconeLucroPercentual">
                        <graphic>
                            <ImageView fitHeight="50.0" fitWidth="50.0">
                                <Image url="@../../icons/home/lucro_percentual.png" />
