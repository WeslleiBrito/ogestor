                                <Image url="@../../icons/home/despesa_variavel.png" />
                                <viewport><Rectangle2D /></viewport>
                            </ImageView>
                        </graphic>
                    </Label>
                    <Label text="Despesa Variável">
                        <font><Font name="Tahoma Bold" size="14.0" /></font>
