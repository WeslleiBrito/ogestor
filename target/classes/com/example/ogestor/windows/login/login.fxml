<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.ogestor.controller.LoginController"
            stylesheets="@login.css"
>
    <children >
        <VBox alignment="CENTER" spacing="15">
            <padding>
                <Insets right="20" left="20"/>
            </padding>
            <children>
                <Label text="Login" style="-fx-font-size: 24px;"/>

                <TextField fx:id="usernameField" promptText="Usuário"/>
                <PasswordField fx:id="passwordField" promptText="Senha"/>
                <HBox alignment="CENTER" spacing="15">
                    <Button text="Entrar" onAction="#handleLoginAction" prefWidth="120"/>
                    <Button text="Sair" onAction="#handleExitAction"/>
                </HBox>
                <Button text="Novo usuário" onAction="#handleCallSignup"/>
                <Label fx:id="messageLabel" textFill="red"/>
            </children>
        </VBox>
    </children>
</StackPane>
