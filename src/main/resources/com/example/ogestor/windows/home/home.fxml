                  <HBox alignment="BOTTOM_CENTER" spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#buscarValorTotalPorData" prefHeight="25.0" prefWidth="120.0" text="Buscar" />
                        <Button mnemonicParsing="false" onAction="#atualizarValorTotal" prefHeight="25.0" prefWidth="120.0" text="Atualizar" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <opaqueInsets>
               <Insets />
            </opaqueInsets>
            <VBox.margin>
               <Insets top="30.0" />
            </VBox.margin>
      
          </HBox>
         <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" VBox.vgrow="SOMETIMES">
            <children>
               <TableView tableMenuButtonVisible="true">
                 <columns>
                   <TableColumn prefWidth="75.0" text="Código" />
                   <TableColumn editable="false" prefWidth="500.0" text="Produto" />
                     <TableColumn minWidth="0.0" prefWidth="75.0" text="Quantidade" />
                     <TableColumn minWidth="0.0" prefWidth="0.0" text="Custo" />
