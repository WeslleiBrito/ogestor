                              <graphic>
                                  <ImageView fitHeight="50.0" fitWidth="50.0">
                                      <Image url="@../../icons/home/faturamento.png" />
                                      <viewport>
                                          <Rectangle2D />
                                      </viewport>
                                  </ImageView>
                              </graphic>
                          </Label>
                          <Label text="Faturamento">
                              <font>
                           <Font name="Tahoma Bold" size="14.0" />
                        </font>
                          </Label>
                          <Label fx:id="lblValorFaturamento" text="valor">
                              <font>
                           <Font name="Trebuchet MS Bold" size="16.0" />
                        </font>
                          </Label>
                          <cursor>
                        <Cursor fx:constant="DEFAULT" />
                     </cursor>
                          <effect>
                        <Blend />
                     </effect>
                      </VBox>
                  </children>
